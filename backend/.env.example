PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/relay_db
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/relay_test
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Agent Layer Configuration
# MODEL_PROVIDER: mock | meta | meta-spark | meta-model | spark-open
MODEL_PROVIDER=mock
MAX_AGENT_STEPS=20

# Optional Meta Model Provider (Meta Model API / Muse Spark, OpenAI-compatible)
# Set MODEL_PROVIDER=meta plus META_MODEL_API_KEY to enable live inference.
# NEVER commit a real key: placeholders only.
META_MODEL_API_KEY=your_meta_model_api_key_here
META_MODEL_NAME=muse-spark-1.3
META_MODEL_BASE_URL=https://api.meta.ai/v1
META_MODEL_TIMEOUT_MS=30000

# Optional Spark Open Provider (Open-weight local/hosted deployment)
SPARK_OPEN_BASE_URL=http://localhost:8000/v1
SPARK_OPEN_MODEL_NAME=spark-open-7b

# Optional Geoapify Provider
GEOAPIFY_API_KEY=your_geoapify_key_here
GEOAPIFY_BASE_URL=https://api.geoapify.com
SUPPLIER_DISCOVERY_PROVIDER=mock

# Optional Resend Email Supplier Contact Provider
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Relay Procurement <procurement@relaycommunity.com>
SUPPLIER_CONTACT_PROVIDER=mock

# =============================================================================
# Authentication Providers
# =============================================================================
# Google OAuth 2.0 / OpenID Connect (GCP Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# SMS / Phone OTP Provider (Twilio Verify Service)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid
TWILIO_PHONE_NUMBER=+1234567890
SMS_PROVIDER=mock
